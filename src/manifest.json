{
  "id": "/",
  "name": "مواقيت الصلاة",
  "short_name": "أوقات الصلاة",
  "description": "مواقيت الصلاة لمركز مدينتك بطريقة الجهة الرسمية في بلدك، مع عدّ تنازلي للصلاة القادمة والتاريخ الهجري وتذكيرات في التقويم. يفتح فورًا ويعمل دون إنترنت، مجاني وبلا إعلانات.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "background_color": "#f8fafc",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
